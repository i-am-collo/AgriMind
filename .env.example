# AgriMind — Environment Variables Reference
# ============================================
# Copy this file to .env in the project root and fill in real values.
# The .env file is in .gitignore — NEVER commit secrets to version control.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default for local development — no setup required)
DATABASE_URL=sqlite:///./agrimind.db

# PostgreSQL example (production)
# DATABASE_URL=postgresql://agrimind_user:strongpassword@localhost:5432/agrimind

# ---------------------------------------------------------------------------
# Self-hosted VLM Inference Endpoint (vLLM or NVIDIA NIM)
# ---------------------------------------------------------------------------
# Base URL of your vLLM or NIM server (no trailing slash).
# When running locally:      http://localhost:8000
# When running on Brev GPU:  https://<brev-tunnel-url>
# Leave as default if not yet provisioned — the engine falls back to Gemini
# or the keyword-matcher automatically.
INFERENCE_ENDPOINT_URL=http://localhost:8000

# HuggingFace model ID as passed to vLLM's --model flag.
# Must exactly match what the server was started with.
INFERENCE_MODEL_NAME=Qwen/Qwen2-VL-7B-Instruct

# Request timeout in seconds. Increase for slow GPU cold-starts.
INFERENCE_TIMEOUT_SECONDS=120

# Number of HTTP-level retries on transient connectivity errors.
INFERENCE_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Legacy Gemini 2.5 Flash (optional — leave blank to disable)
# ---------------------------------------------------------------------------
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# HuggingFace Hub token (required on the GPU host to download model weights)
# Set this on the Brev Launchable / Brev Secrets — not on the app server.
# ---------------------------------------------------------------------------
HF_TOKEN=hf_your_token_here
